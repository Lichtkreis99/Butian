{
  "name": "xuanye",
  "version": "0.1.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build-data": "node --import tsx scripts/build-stars.ts && node --import tsx scripts/build-textures.ts && node --import tsx scripts/build-phase5-data.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "verify:stars": "node --import tsx scripts/verify-stars.ts",
    "verify:ephemeris": "node --import tsx scripts/verify-ephemeris.ts",
    "verify:pointer": "node --import tsx scripts/verify-pointer.ts",
    "verify:engines": "node --import tsx scripts/verify-engines.ts",
    "verify:boundary": "node --import tsx scripts/verify-boundary.ts",
    "verify:linkage": "node --import tsx scripts/verify-linkage.ts",
    "verify:projection": "node --import tsx scripts/verify-projection.ts",
    "verify:textures": "node --import tsx scripts/verify-textures.ts",
    "verify:context": "node --import tsx scripts/verify-context.ts",
    "verify:names": "node --import tsx scripts/verify-names.ts",
    "verify:virtual-radius": "node --import tsx scripts/verify-virtual-radius.ts",
    "verify:orientation": "node --import tsx scripts/verify-orientation.ts",
    "verify:stability": "node --import tsx scripts/verify-stability.ts",
    "verify:planetarium": "node --import tsx scripts/verify-planetarium.ts",
    "verify:layout": "node --import tsx scripts/verify-layout.ts",
    "verify:labels": "node --import tsx scripts/verify-labels.ts",
    "verify:culture": "node --import tsx scripts/verify-culture.ts",
    "verify:glyphs": "node --import tsx scripts/verify-glyphs.ts",
    "verify:visibility": "node --import tsx scripts/verify-visibility.ts",
    "verify:gaitian": "node --import tsx scripts/verify-gaitian.ts",
    "verify:grid": "node --import tsx scripts/verify-grid.ts",
    "verify:aspects": "node --import tsx scripts/verify-aspects.ts",
    "verify:yaos-rules": "node --import tsx scripts/verify-yaos-rules.ts",
    "verify:geju": "node --import tsx scripts/verify-geju.ts",
    "verify:relations": "node --import tsx scripts/verify-relations.ts",
    "verify:sky": "node --import tsx scripts/verify-sky.ts",
    "verify:file-protocol": "node --import tsx scripts/verify-file-protocol.ts",
    "check": "npm run typecheck && npm run build && npm run verify:stars && npm run verify:ephemeris && npm run verify:pointer && npm run verify:engines && npm run verify:boundary && npm run verify:linkage && npm run verify:projection && npm run verify:textures && npm run verify:context && npm run verify:names && npm run verify:virtual-radius && npm run verify:orientation && npm run verify:stability && npm run verify:layout && npm run verify:labels && npm run verify:planetarium && npm run verify:culture && npm run verify:glyphs && npm run verify:visibility && npm run verify:gaitian && npm run verify:grid && npm run verify:aspects && npm run verify:yaos-rules && npm run verify:geju && npm run verify:relations && npm run verify:sky && npm run verify:file-protocol"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "lunar-javascript": "1.7.7",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/three": "0.186.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  }
